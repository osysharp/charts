// Charts@1: the chart kit (`using Osysharp.Charts;`).
//
// A charting library written entirely in Osy#, with no JavaScript. Every mark is an ordinary Osy# element or a
// `Path`, drawn with plain arithmetic: no bundle, no shim and no `control` declaration.
//
// Why the marks are elements and not canvas pixels: a `<canvas>` chart has to re-implement hit-testing, focus,
// keyboard traversal and screen-reader semantics against pixel coordinates, and that work is most of a charting
// library. Here each mark is a DOM element with a role and an accessible name, so hover and screen-reader semantics
// come from the browser. `Path` covers the shapes elements cannot express (a line, an area).
//
// Its colours are the theme's: the card, the ink and the gridlines are the app's surface and text tones, and the
// series lead with the app's accent, then continue with eight hues validated for colour-vision-deficiency separation,
// skipping any too close to the accent. They are assigned in a fixed order and never cycled: a ninth series gets no
// new hue, it is a signal to group.

namespace Osysharp.Charts;

// ── the design tokens ────────────────────────────────────────────────────────────────────────────────────
//
// A chart FOLLOWS THE THEME IT IS DRAWN IN. Its card, ink, gridlines and readout are the theme's own surface, text and
// rule colours, and its first series is the theme's accent, so a chart in an app — whatever look or theme the app
// wears — looks like part of the page it sits on, in light and dark, without the app writing a line for it. Every
// token is still the app's to shadow (`Colors { Series2 = "#…"; ChartGrid = Colors.Border; }`), and the app's value
// wins wherever the kit reads it.
theme Charts {
  Colors {
    // ⭐ THE SERIES LEAD WITH THE ACCENT, then continue with eight fixed hues, in an order chosen for
    //    colour-vision-deficiency separation. `Palette.Series` drops every hue too close to the accent to be told apart
    //    from it (in light OR dark mode, so a series is one hue in both), so an orange accent does not sit beside the
    //    orange series and a violet one beside the violet. Which hues those are depends on the accent, and the accent
    //    is the app's, so the compile chooses — measured on the five app looks, every one collided with one or two of
    //    the eight. Past the last hue a series keeps the last one: a ninth series is a signal to group, not a new hue.
    //
    //    The hues are validated for CVD separation, a lightness band, a chroma floor and surface contrast: worst
    //    adjacent CVD ΔE 9.1 light / 8.4 dark against a target of 8, worst normal-vision ΔE 19.6 / 19.3 against a
    //    floor of 15. Blue, orange, aqua, yellow, magenta, green, violet, red.
    Series1 = Colors.Primary;
    Series2 = Palette.Series(2, Colors.Primary, "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948");
    Series3 = Palette.Series(3, Colors.Primary, "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948");
    Series4 = Palette.Series(4, Colors.Primary, "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948");
    Series5 = Palette.Series(5, Colors.Primary, "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948");
    Series6 = Palette.Series(6, Colors.Primary, "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948");
    Series7 = Palette.Series(7, Colors.Primary, "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948");
    Series8 = Palette.Series(8, Colors.Primary, "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948");
    // The chart's own furniture, recessive by construction and the theme's own: the card is the theme's surface and its
    // card hairline, a gridline is the theme's muted tint (one step off the surface, never a mid-grey rule competing
    // with the data), and the text tiers are its ink and muted text. A label never wears a series colour, because a
    // light categorical hue (yellow, aqua) is illegible as text; identity belongs to the swatch beside the text.
    //
    // Named `Chart*` rather than read as `Surface`/`Border` directly so an app can re-dress the chart alone — a chart
    // card one shade off the page, say — without touching every other card.
    ChartSurface = Colors.Surface;
    ChartBorder  = Colors.CardLine;
    ChartGrid    = Colors.Muted;
    ChartInk     = Colors.OnSurface;
    ChartMuted   = Colors.TextMuted;
    // The hover readout, inverted against the card in both modes: a tooltip that shares the chart's surface reads as
    // part of the picture, and it sits on top of marks it must stay legible against. The crosshair is the muted text
    // tone — visible on the card without being mistaken for a gridline.
    ChartTipBg  = Colors.OnSurface;
    ChartTipInk = Colors.Surface;
    ChartCross  = Colors.TextMuted;
    // Annotations get their own ink rather than a palette slot. Every `Series*` hue means "this series", and an
    // annotation that borrowed one would read as a series, when annotations deliberately have no legend entry, no
    // palette slot and no effect on the scale. A neutral violet ink no theme token stands for says "this is a note
    // about the chart" — the kit's own colour, for that reason.
    ChartNote  = Modes.Of(light: "#7A4BC4", dark: "#B695F0");
    // The one place colour carries meaning rather than identity: which way a candle went. Up and down are the theme's
    // success and danger tones — the green and red readers of price charts already know, in the theme's own shades.
    //
    // Colour is not the only channel: for a reader with a red/green colour-vision deficiency it carries nothing. A
    // candle's direction is also its shape (a down candle is filled, an up candle hollow), which survives a greyscale
    // print, a `forced-colors` display and deuteranopia.
    ChartUp   = Colors.Success;
    ChartDown = Colors.Danger;
  }
  // Type, under chart-owned names for the same reason as the colours, and the theme's own steps: a look that sets its
  // body at 16px for legibility sets the chart's labels with it.
  FontSize {
    ChartTitle = FontSize.Subhead;
    ChartLabel = FontSize.Label;
    ChartTick  = FontSize.Caption;
  }
  FontWeight { ChartStrong = FontWeight.Semibold; }
  // The readout's fade and layer — the chart's own timing and stacking, which no theme step stands for.
  Motion { ChartFade = "opacity 0.12s ease"; }
  ZIndex { ChartTip = 600; }
}
